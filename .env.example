# Kalyan AI Personality Engine — Production / Staging Environment Configuration
# All values must be supplied from environment or secure secret manager (e.g. AWS Secrets Manager, HashiCorp Vault)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

# Application & Security
PROJECT_NAME="Kalyan — AI Personality Engine"
VERSION="1.0.0"
SECRET_KEY="REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"
ALGORITHM="HS256"

# Bootstrap Passwords (Required for initial zero-state operator/admin seeding)
# Must be at least 12 characters with upper, lower, digit, and symbol
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
OPERATOR_BOOTSTRAP_PASSWORD="REPLACE_WITH_STRONG_OPERATOR_PASSWORD"

# Database Configuration (PostgreSQL in production, SQLite for local testing)
DATABASE_URL="sqlite:///./kalyan_personality.db"
# DATABASE_URL="postgresql://kalyan_user:STRONG_DB_PASSWORD@localhost:5432/kalyan_db"

# LLM Providers Configuration
DEFAULT_PROVIDER="mock"  # "mock" | "gemini" | "openai" | "anthropic"
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
OPENAI_API_KEY="REPLACE_WITH_OPENAI_API_KEY"
ANTHROPIC_API_KEY="REPLACE_WITH_ANTHROPIC_API_KEY"

# Live Social Broadcasting Adapters (Default: false for safety)
ENABLE_LIVE_SOCIAL_BROADCAST="false"
X_API_KEY="REPLACE_WITH_X_API_KEY"
X_API_SECRET="REPLACE_WITH_X_API_SECRET"
X_ACCESS_TOKEN="REPLACE_WITH_X_ACCESS_TOKEN"
X_ACCESS_SECRET="REPLACE_WITH_X_ACCESS_SECRET"
INSTAGRAM_ACCESS_TOKEN="REPLACE_WITH_INSTAGRAM_ACCESS_TOKEN"
INSTAGRAM_PAGE_ID="REPLACE_WITH_INSTAGRAM_PAGE_ID"
YOUTUBE_API_KEY="REPLACE_WITH_YOUTUBE_API_KEY"
WHATSAPP_TOKEN="REPLACE_WITH_WHATSAPP_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_VERIFY_TOKEN="REPLACE_WITH_WHATSAPP_VERIFY_TOKEN"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_REPLACE_WITH_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET"

# Financial Telemetry & Budget Caps
DAILY_COST_BUDGET_USD="50.0"
COST_PER_1K_INPUT_TOKENS_USD="0.0005"
COST_PER_1K_OUTPUT_TOKENS_USD="0.0015"
INR_PER_USD="86.0"

# Operational Controls
KILL_SWITCH_ACTIVE="false"
REQUIRE_HUMAN_APPROVAL_FOR_TIER1="false"
